{
  "nodeModulesDir": "none",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@supabase/server": "npm:@supabase/server@1.9.2",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.119.0",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "stripe": "npm:stripe@22.6.2"
  },
  "fmt": {
    "include": ["."],
    "lineWidth": 88,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "include": ["."]
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check */index.ts"
  }
}
